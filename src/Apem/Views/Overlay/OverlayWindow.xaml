<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Apem.Views.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Apem.Views.Overlay"
    xmlns:models="using:Apem.Models"
    xmlns:services="using:Apem.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="APEM Overlay"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Canvas x:Name="PanelCanvas" Background="Transparent">
            <local:OverlayPanelHost
                x:Name="ScoreboardPanel"
                Title="MATCH"
                Canvas.Left="24"
                Canvas.Top="24"
                Width="320"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ClockText" Style="{StaticResource HudBodyStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="ScoreText" Style="{StaticResource HudBodyStyle}" />
                            <TextBlock x:Name="NetWorthText" Style="{StaticResource HudMutedStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="GameStateText" Style="{StaticResource HudMutedStyle}" />
                    </StackPanel>
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>

            <local:OverlayPanelHost
                x:Name="PlayerPanel"
                Title="YOU"
                Canvas.Left="24"
                Canvas.Top="120"
                Width="320"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="HeroText" Style="{StaticResource HudBodyStyle}" />
                        <TextBlock x:Name="KdaText" Style="{StaticResource HudBodyStyle}" />
                        <TextBlock x:Name="EconomyText" Style="{StaticResource HudMutedStyle}" />
                        <ProgressBar x:Name="HealthBar" Maximum="1" Foreground="{StaticResource HudRadiantBrush}" />
                        <ProgressBar x:Name="ManaBar" Maximum="1" Foreground="#4A8FD4" />
                    </StackPanel>
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>

            <local:OverlayPanelHost
                x:Name="ItemsPanel"
                Title="ITEMS"
                Canvas.Left="24"
                Canvas.Top="320"
                Width="320"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <ListView x:Name="ItemsList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SlotSnapshot">
                                <TextBlock Style="{StaticResource HudMutedStyle}" Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>

            <local:OverlayPanelHost
                x:Name="AbilitiesPanel"
                Title="ABILITIES"
                Canvas.Left="24"
                Canvas.Top="460"
                Width="320"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <ListView x:Name="AbilitiesList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SlotSnapshot">
                                <TextBlock Style="{StaticResource HudMutedStyle}" Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>

            <local:OverlayPanelHost
                x:Name="TimersPanel"
                Title="TIMERS"
                Canvas.Left="420"
                Canvas.Top="24"
                Width="280"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <StackPanel Spacing="8">
                        <ListView x:Name="TimersList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:TimerEntry">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Style="{StaticResource HudMutedStyle}" Text="{x:Bind Name}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource HudBodyStyle}" Text="{x:Bind Display}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="MarkRoshButton" Content="Mark Rosh" />
                            <Button x:Name="ClearRoshButton" Content="Clear" />
                        </StackPanel>
                    </StackPanel>
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>

            <local:OverlayPanelHost
                x:Name="DraftPanel"
                Title="COUNTERS"
                Canvas.Left="420"
                Canvas.Top="260"
                Width="280"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <ListView x:Name="CountersList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:CounterSuggestion">
                                <TextBlock Style="{StaticResource HudBodyStyle}" Text="{x:Bind HeroName}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>

            <local:OverlayPanelHost
                x:Name="BuildPanel"
                Title="BUILD"
                Canvas.Left="420"
                Canvas.Top="520"
                Width="280"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <ListView x:Name="BuildList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BuildSuggestionItem">
                                <TextBlock Style="{StaticResource HudMutedStyle}" Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>
        </Canvas>

        <Border
            x:Name="InteractiveBanner"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,12,0,0"
            Padding="12,6"
            Background="#CC1A2430"
            CornerRadius="6"
            Visibility="Collapsed">
            <TextBlock
                Foreground="{StaticResource HudAccentBrush}"
                Text="Interactive mode — drag panels. Alt+` to exit." />
        </Border>
    </Grid>
</Window>
