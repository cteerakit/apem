<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Apem.Views.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Apem.Views.Overlay"
    xmlns:models="using:Apem.Models"
    xmlns:winuiex="using:WinUIEx"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Mango Overlay"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <winuiex:TransparentTintBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Background="Transparent">
        <Canvas x:Name="PanelCanvas" Background="Transparent">
            <local:OverlayPanelHost
                x:Name="PlayerPanel"
                MinimalChrome="True"
                Canvas.Left="24"
                Canvas.Top="120"
                Width="164"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <local:HudStatRow x:Name="EconomyRow" Label="GPM/XPM" Value="0 / 0" />
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>

            <!-- One panel per timer so each can be placed independently. -->
            <local:OverlayPanelHost
                x:Name="BountyTimerPanel"
                MinimalChrome="True"
                Canvas.Left="320"
                Canvas.Top="24"
                Width="92"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <local:HudStatRow
                        x:Name="BountyTimerRow"
                        LabelIcon="ms-appx:///Assets/Hud/bounty-rune.png"
                        LabelIconSize="18"
                        LabelWidth="26"
                        RightEdge="True" />
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>

            <local:OverlayPanelHost
                x:Name="PowerTimerPanel"
                MinimalChrome="True"
                Canvas.Left="320"
                Canvas.Top="50"
                Width="92"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <local:HudStatRow
                        x:Name="PowerTimerRow"
                        LabelIcon="ms-appx:///Assets/Hud/power-rune.png"
                        LabelIconSize="18"
                        LabelWidth="26"
                        RightEdge="True" />
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>

            <local:OverlayPanelHost
                x:Name="WisdomTimerPanel"
                MinimalChrome="True"
                Canvas.Left="320"
                Canvas.Top="76"
                Width="92"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <local:HudStatRow
                        x:Name="WisdomTimerRow"
                        LabelIcon="ms-appx:///Assets/Hud/wisdom-rune.png"
                        LabelIconSize="18"
                        LabelWidth="26"
                        RightEdge="True" />
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>

            <local:OverlayPanelHost
                x:Name="LotusTimerPanel"
                MinimalChrome="True"
                Canvas.Left="320"
                Canvas.Top="102"
                Width="92"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <local:HudStatRow
                        x:Name="LotusTimerRow"
                        LabelIcon="ms-appx:///Assets/Hud/lotus-pool.png"
                        LabelIconSize="18"
                        LabelWidth="26"
                        RightEdge="True" />
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>

            <local:OverlayPanelHost
                x:Name="BuildPanel"
                Title="BUILD"
                Canvas.Left="320"
                Canvas.Top="260"
                Width="280"
                Visibility="Collapsed">
                <local:OverlayPanelHost.PanelContent>
                    <ListView x:Name="BuildList" SelectionMode="None">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BuildSuggestionItem">
                                <TextBlock Style="{StaticResource HudMutedStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </local:OverlayPanelHost.PanelContent>
            </local:OverlayPanelHost>
        </Canvas>

        <Border
            x:Name="InteractiveBanner"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,12,0,0"
            Padding="12,6"
            Background="#CC1A2430"
            CornerRadius="6"
            Visibility="Collapsed">
            <TextBlock
                Foreground="{StaticResource HudAccentBrush}"
                Text="Interactive mode — drag widgets. Alt+` to exit." />
        </Border>
    </Grid>
</Window>
