<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Apem.Views.Overlay.HudStatRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- Geometry matches the in-game stat rows: 22px row, label at x=11, values column at x=78. -->
    <Grid Height="22">
        <Border
            x:Name="FadeBackground"
            Background="Transparent"
            SizeChanged="OnFadeBackgroundSizeChanged" />

        <Grid x:Name="ContentGrid" Padding="10,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LabelColumn" Width="67" />
                <ColumnDefinition x:Name="ValueColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="LabelHost"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Grid>
                    <Border x:Name="LabelShadowHost" IsHitTestVisible="False" />
                    <TextBlock
                        x:Name="LabelText"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource HudStatFadeLabelStyle}"
                        Text="{x:Bind Label, Mode=OneWay}" />
                    <Image
                        x:Name="LabelIconImage"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Source="{x:Bind LabelIcon, Mode=OneWay}"
                        Visibility="Collapsed" />
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="ValueHost"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Grid>
                    <Border x:Name="ValueShadowHost" IsHitTestVisible="False" />
                    <TextBlock
                        x:Name="ValueText"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource HudStatFadeValueStyle}"
                        Text="{x:Bind Value, Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
