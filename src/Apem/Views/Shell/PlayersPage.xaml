<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Apem.Views.Shell.PlayersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <Style x:Key="ScoreboardHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ScoreboardCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <DataTemplate x:Key="PlayerRowTemplate">
            <Grid ColumnSpacing="8" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource ScoreboardCellTextStyle}" Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Style="{StaticResource ScoreboardCellTextStyle}" Text="{Binding DisplayHeroName}" />
                <TextBlock Grid.Column="2" Style="{StaticResource ScoreboardCellTextStyle}" Text="{Binding HeroLevel}" />
                <TextBlock Grid.Column="3" Style="{StaticResource ScoreboardCellTextStyle}" Text="{Binding Kda}" />
                <TextBlock Grid.Column="4" Style="{StaticResource ScoreboardCellTextStyle}" Text="{Binding LastHitsDenies}" />
                <TextBlock Grid.Column="5" Style="{StaticResource ScoreboardCellTextStyle}" Text="{Binding Gpm}" />
                <TextBlock Grid.Column="6" Style="{StaticResource ScoreboardCellTextStyle}" Text="{Binding Xpm}" />
                <TextBlock Grid.Column="7" Style="{StaticResource ScoreboardCellTextStyle}" Text="{Binding Gold}" />
                <Button
                    Grid.Column="8"
                    Padding="8,4"
                    MinWidth="80"
                    Click="OnAddNoteClick"
                    Content="{Binding NoteButtonLabel}"
                    ToolTipService.ToolTip="{Binding Note}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="LayoutRoot">
        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentColumn"
                Padding="32"
                Spacing="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <StackPanel Spacing="8">
                    <TextBlock Text="Players" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Waiting for Dota 2."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Radiant" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="Player" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="Hero" />
                            <TextBlock Grid.Column="2" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="Lvl" />
                            <TextBlock Grid.Column="3" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="KDA" />
                            <TextBlock Grid.Column="4" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="LH-DN" />
                            <TextBlock Grid.Column="5" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="GPM" />
                            <TextBlock Grid.Column="6" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="XPM" />
                            <TextBlock Grid.Column="7" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="Gold" />
                            <TextBlock Grid.Column="8" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="Note" />
                        </Grid>
                        <ItemsControl x:Name="RadiantPlayersList" ItemTemplate="{StaticResource PlayerRowTemplate}" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Dire" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="Player" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="Hero" />
                            <TextBlock Grid.Column="2" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="Lvl" />
                            <TextBlock Grid.Column="3" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="KDA" />
                            <TextBlock Grid.Column="4" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="LH-DN" />
                            <TextBlock Grid.Column="5" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="GPM" />
                            <TextBlock Grid.Column="6" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="XPM" />
                            <TextBlock Grid.Column="7" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="Gold" />
                            <TextBlock Grid.Column="8" Style="{StaticResource ScoreboardHeaderTextStyle}" Text="Note" />
                        </Grid>
                        <ItemsControl x:Name="DirePlayersList" ItemTemplate="{StaticResource PlayerRowTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
