<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Apem.Views.Shell.NotesListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <Style x:Key="FactLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="FactValueStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
    </Page.Resources>

    <Grid x:Name="LayoutRoot">
        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentColumn"
                Padding="32"
                Spacing="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <StackPanel Spacing="8">
                    <TextBlock Text="Notes" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Saved player notes."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Name="EmptyText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No notes yet. Add notes from Match, or import a backup."
                            TextWrapping="WrapWholeWords"
                            Visibility="Collapsed" />
                        <ItemsControl x:Name="NotesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="16"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="16" RowSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Style="{StaticResource FactLabelStyle}" Text="Player name" />
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Style="{StaticResource FactValueStyle}"
                                                    Text="{Binding DisplayName}" />
                                                <TextBlock Grid.Row="1" Style="{StaticResource FactLabelStyle}" Text="ID" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Style="{StaticResource FactValueStyle}"
                                                    Text="{Binding DisplayId}" />
                                                <TextBlock Grid.Row="2" Style="{StaticResource FactLabelStyle}" Text="Content" />
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Style="{StaticResource FactValueStyle}"
                                                    Text="{Binding Content}" />
                                                <TextBlock Grid.Row="3" Style="{StaticResource FactLabelStyle}" Text="Likes" />
                                                <TextBlock
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Style="{StaticResource FactValueStyle}"
                                                    Text="{Binding LikeCount}" />
                                                <TextBlock Grid.Row="4" Style="{StaticResource FactLabelStyle}" Text="Dislikes" />
                                                <TextBlock
                                                    Grid.Row="4"
                                                    Grid.Column="1"
                                                    Style="{StaticResource FactValueStyle}"
                                                    Text="{Binding DislikeCount}" />
                                                <TextBlock Grid.Row="5" Style="{StaticResource FactLabelStyle}" Text="Date/time" />
                                                <TextBlock
                                                    Grid.Row="5"
                                                    Grid.Column="1"
                                                    Style="{StaticResource FactValueStyle}"
                                                    Text="{Binding DisplayUpdatedAt}" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Button
                                                    AutomationProperties.Name="Edit note"
                                                    Click="OnEditNoteClick"
                                                    Content="Edit" />
                                                <Button
                                                    AutomationProperties.Name="Delete note"
                                                    Click="OnDeleteNoteClick"
                                                    Content="Delete" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
