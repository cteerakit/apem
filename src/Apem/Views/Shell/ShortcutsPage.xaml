<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Apem.Views.Shell.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Grid x:Name="LayoutRoot">
        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentColumn"
                Padding="32"
                Spacing="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <StackPanel Spacing="8">
                    <TextBlock Text="Shortcuts" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Click Change, then press the new key combination. Include at least one modifier."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Toggle overlay" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="OverlayHotkeyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button
                                x:Name="ChangeOverlayButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Content="Change"
                                Click="ChangeOverlayButton_Click" />
                            <TextBlock
                                x:Name="OverlayCaptureHint"
                                Grid.Row="0"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Visibility="Collapsed"
                                Text="Press keys…" />

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Interactive mode" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="InteractiveHotkeyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button
                                x:Name="ChangeInteractiveButton"
                                Grid.Row="1"
                                Grid.Column="1"
                                Content="Change"
                                Click="ChangeInteractiveButton_Click" />
                            <TextBlock
                                x:Name="InteractiveCaptureHint"
                                Grid.Row="1"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Visibility="Collapsed"
                                Text="Press keys…" />
                        </Grid>

                        <TextBlock
                            x:Name="StatusMessageText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="SaveButton" Content="Save shortcuts" Click="SaveButton_Click" />
                            <Button x:Name="ResetButton" Content="Reset defaults" Click="ResetButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
